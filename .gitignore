# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Android Studio / IntelliJ
*.iml
.idea/
local.properties
# AGP's default `captures/` output is gitignored; we don't use AGP's
# screenshot test infrastructure so this stays. (Removed from the M0
# .gitignore so app/src/main/java/com/baton/app/data/captures/ can
# be tracked.)
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class

# Kotlin
.kotlin/

# Keystores
*.jks
*.keystore

# Logs
*.log
hs_err_pid*
replay_pid*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
*.swp
*.swo

# Project-local
app/release/
app/debug/
*.hprof
*.trace
.kotlin/

# M1-T3: vendored llama.cpp source tree, downloaded by the
# `vendorLlamaCpp` Gradle task at configuration time. Rebuilds
# are cheap (CMake caches the configure step) so this stays out
# of the repo. Delete the directory to force a re-vendor.
app/src/main/cpp/llama-cpp/

# Local AI model files (downloaded at first run, NOT in repo)
models/*.gguf
models/*.bin
*.gguf
*.bin
models-cache/

# Secrets
secrets.properties
google-services.json
.env
.env.local

# Ad-hoc emulator debug artifacts (left behind by adb shell input + uiautomator
# dump during live e2e testing). Real verification screenshots live in
# docs/verification/ and ARE checked in.
ui-*.xml
ui.xml
.gradle-build.log
m0-*.png
m0-*.xml
baton-*.png

# But keep the curated evidence set
!docs/verification/
