# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Android Studio / IntelliJ
*.iml
.idea/
local.properties
# AGP's default `captures/` output is gitignored; we don't use AGP's
# screenshot test infrastructure so this stays. (Removed from the M0
# .gitignore so app/src/main/java/com/baton/app/data/captures/ can
# be tracked.)
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class

# Kotlin
.kotlin/

# Keystores
*.jks
*.keystore
# v1.3 (F-CRIT-03): the production release keystore IS committed
# so a fresh clone + build produces a Play-acceptable APK. The
# password lives in local.properties (gitignored above). The
# baton-debug.keystore stays ignored — it's regenerated locally
# for ad-hoc device installs only.
!app/baton-release.keystore

# Logs
*.log
hs_err_pid*
replay_pid*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
*.swp
*.swo

# Project-local
app/release/
app/debug/
*.hprof
*.trace
.kotlin/

# M1-T3: vendored llama.cpp source tree, downloaded by the
# `vendorLlamaCpp` Gradle task at configuration time. Rebuilds
# are cheap (CMake caches the configure step) so this stays out
# of the repo. Delete the directory to force a re-vendor.
app/src/main/cpp/llama-cpp/

# M2-T3: vendored whisper.cpp source tree, downloaded by the
# `vendorWhisperCpp` Gradle task. Same rationale as llama-cpp.
app/src/main/cpp/whisper-cpp/

# Failed v1.8.1 vendor attempt; never built into the app.
app/src/main/cpp/whisper-cpp.v1.8.1.bak.tmp.removed/

# Local AI model files (downloaded at first run, NOT in repo)
models/*.gguf
models/*.bin
*.gguf
*.bin
models-cache/

# Secrets
secrets.properties
google-services.json
.env
.env.local

# Ad-hoc emulator debug artifacts (left behind by adb shell input + uiautomator
# dump during live e2e testing). The leading slash anchors the pattern to
# the repo root, so the same filename in docs/verification/ is NOT
# ignored. Real verification screenshots live in docs/verification/ and
# ARE checked in.
/ui-*.xml
/ui.xml
/ui_*.xml
/v170_*.xml
/ui_v171*.xml
/ui_v172*.xml
/ui_v173*.xml
/ui_v173*.txt
/critique_*.png
/critique_*.xml
/.gradle-build.log
/m[0-9]-*.png
/m[0-9]-*.xml
/baton-*.png
# v1.7.2: ad-hoc drive-verify helper scripts (Python one-liners
# used during the critique walkthrough). Re-runnable from the
# repo root (`python parse-ui.py ui_v172_*.xml`).
/parse-ui.py
/parse-y.py
/find-*.py
/check-*.py
/count-*.py
/dump-*.py
/fix-*.py
# v1.7.3: drive-verify helper scripts (added for the
# fresh-eyes critique walkthrough on emulator-5554).
/parse-*.py
/commit_msg.txt

# Subagent implementation artifacts (briefs, reports, reviews, diffs)
# These document the build process but are not part of the deliverable.
.sdd/review-*.diff
.sdd/task-*-brief.md
.sdd/task-*-report.md
.sdd/task-*-review.md
.sdd/task-*-re-review.md
.sdd/task-*-fix-report.md
.sdd/task-*-todos.md
.sdd/task-*-sqlcipher-fix.md
tmp/

# v1.8.0 dev scratchpads (PowerShell deletion is blocked so the
# files get renamed to a non-source extension; the Kotlin source
# set glob is *.kt, so files with .todelete* / .disabled / .bak
# suffixes are not compiled. They sit on disk as a safety net in
# case the user wants to recover the contents.)
*.todelete
*.todelete2
*.todelete3
*.todelete4
*.disabled
*.bak
test_summary.txt
.sdd/
