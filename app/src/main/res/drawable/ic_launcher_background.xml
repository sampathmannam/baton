<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.6.3 launcher-icon background. Solid warm cream (#F2EBDC) so the
  indigo shield foreground sits on a calm, paper-like surface and
  the W-shaped negative-space cutout reads as cream-on-cream. This
  matches the design language of the legacy mipmap PNGs (same cream
  background) and the in-app Material theme (light surface = cream).
  v1.5.7 used a teal-to-coral gradient; v1.6.3 simplifies to a
  solid colour to give the shield full visual weight.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F2EBDC" />
</shape>
