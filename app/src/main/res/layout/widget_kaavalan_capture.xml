<?xml version="1.0" encoding="utf-8"?>
<!--
  Kaavalan capture widget. Single mic button; tap to launch MainActivity
  with the ACTION_QUICK_CAPTURE deep link. The widget size is set by
  the AppWidgetProviderInfo XML.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageButton
        android:id="@+id/widget_mic_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_mic_button_desc"
        android:scaleType="centerInside"
        android:src="@drawable/ic_mic_widget" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_label"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />
</LinearLayout>
