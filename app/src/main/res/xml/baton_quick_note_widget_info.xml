<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.9.11: AppWidgetProviderInfo for the Quick Note widget
  (BatonQuickNoteWidget + BatonQuickNoteWidgetReceiver).

  v1.9.10 baseline: 2x2 single-tap capture button. v1.9.11:
  resizable in both dimensions with progressive disclosure
  (the user explicitly asked for the larger sizes in the
  v1.9.10 final review).

  Sizing:
    - minWidth 110dp / minHeight 110dp: 2x2 cell floor. Shows
      just the capture button (header row).
    - minResizeWidth 110dp: the widget cannot shrink below
      2 cells wide; vertical-only resize below that.
    - resizeMode: horizontal|vertical. The launcher can
      stretch the widget to 4x2, 4x4, or anything in between.
      The composable renders header + count + recent-list
      stacked top-to-bottom; the launcher clips what doesn't
      fit. Progressive disclosure by host clipping — no
      runtime size detection needed.

  Content by size (what the user sees):
    - 2x2 (~110dp x 110dp):  header only — the capture
      button + "Quick note" label
    - 4x2 (~250dp x 110dp):  header + today's capture count
    - 4x4 (~250dp x 250dp):  header + count + 3 most recent
      capture titles (first-line only, with relative time)

  Privacy:
    - widgetCategory=home_screen: NOT offered on the lock
      screen. Quick-note capture from the lock screen would
      put a text field there, which is a privacy risk we
      explicitly do not take.
    - The recent list shows only the first line of each
      capture's rawText (truncated to 40 chars), with a
      relative time badge. The full body is never on the
      home screen.

  Update:
    - updatePeriodMillis 1800000 (30 min): the system
      minimum. The widget re-renders on every `update` from
      QuickNoteActivity.save().
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_quick_note_loading"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:description="@string/quick_note_widget_description"
    android:previewLayout="@layout/widget_quick_note_loading" />
