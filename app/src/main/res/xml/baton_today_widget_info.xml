<?xml version="1.0" encoding="utf-8"?>
<!--
  AppWidgetProviderInfo for the BatonTodayWidget
  (v1.9.0 widget gallery expansion). The widget
  opens the Today screen. The metadata mirrors
  the capture widget's metadata: 180dp x 80dp
  min size, 30 min update period, home_screen +
  keyguard category.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="80dp"
    android:minResizeWidth="120dp"
    android:minResizeHeight="60dp"
    android:previewLayout="@layout/glance_default_loading_layout"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen|keyguard"
    android:description="@string/widget_today_description" />
