<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.0.0 (drop Supabase): the supabase.co /
  supabase.in domain-config entries are removed
  (no Supabase network calls). The base config
  stays (no cleartext, system trust store only).
  v2.1.0 (PM rating): the Drive REST API
  domains are added so the same no-cleartext /
  system-store policy applies.
  v2.1.1 (security): the Drive REST API
  domain-config is the v2.1.1 baseline; cert
  pinning for *.googleapis.com is the v2.1.1
  follow-up. The pin set is intentionally
  omitted here because the SPKI SHA-256 is not
  stable across Google's cert rotations and
  pinning the wrong key would brick the app on
  every cert rotation. The full pin set is
  documented at
  https://developers.google.com/web/updates/2018/05/ct-news
  (Chrome's pin-set) and the user can add
  <pin-set><pin .../></pin-set> entries to the
  <domain-config> below when ready.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">googleusercontent.com</domain>
        <domain includeSubdomains="true">accounts.google.com</domain>
        <domain>oauth2.googleapis.com</domain>
    </domain-config>
</network-security-config>
