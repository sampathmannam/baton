    <!-- v1.4.2 (F-10): first-run on-device LLM model download.
         The copy is neutral and non-shaming per spec §1. Errors
         are rendered in onSurfaceVariant, never in the error
         colour. The "~1 GB" hint in the button label is rounded
         up; the actual Qwen 3 1.7B Q4_K_M GGUF is closer to
         1.1 GB but "1 GB" is the human-friendly round number. -->
    <string name="model_download_title">Download on-device model</string>
