<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- v2.0 Tier 2 (§2.7, §2.9): read the user's calendar to
         surface the "Brief me before a meeting" card and to
         suggest a calendar link when a capture is saved. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- v2.0 Tier 2 (§2.6): the morning brief notification fires
         at 9 AM via WorkManager; SCHEDULE_EXACT_ALARM lets us
         fire exactly at the user's chosen time. Android 14+
         requires the user to grant this manually; we request it
         from the Settings sheet (no silent ask). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- v1.2: Android 11+ (API 30+) package visibility — declare
         which intents we resolve. Without this, resolveActivity
         returns null for: CalendarContract.ACTION_INSERT, share
         targets from other apps, and the camera intent. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- M1-T6: Calendar integration via CalendarContract.ACTION_INSERT.
         The system Calendar app handles the per-account picker; on
         API 33+ the WRITE_CALENDAR permission is NOT needed because
         the user picks the calendar in the system UI. The
         `maxSdkVersion=32` keeps the manifest clean for newer API
         levels and avoids the runtime permission dance. -->
    <uses-permission
        android:name="android.permission.WRITE_CALENDAR"
        android:maxSdkVersion="32" />

    <!-- M2-T2: photo capture. CAMERA is needed for the in-app
         camera; the M2-T2 plan also wires ML Kit OCR. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- M2-T4: voice capture. RECORD_AUDIO is the runtime mic
         permission; FOREGROUND_SERVICE_MICROPHONE is required on
         API 34+ for any foreground service that uses the
         microphone. The service uses foregroundServiceType=microphone
         (declared below) so the system can revoke it when the user
         doesn't expect it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BatonApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Baton">

        <!-- M3-T2: disable WorkManager's default auto-init.
             The BatonApplication provides a Configuration via
             Configuration.Provider; the manual init lives in
             com.baton.app.data.work.WorkManagerInitializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Baton">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M1-T7 / M2-T1: share target. The user picks Baton from
             another app's share sheet; we forward the shared text
             (or the OCR'd text from a shared image) to MainActivity
             which opens the capture sheet pre-filled. -->
        <activity-alias
            android:name=".features.capture.ShareReceiverActivity"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/share_to_baton">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>

        <!-- M2-T2: FileProvider for the in-app camera. The system
             camera writes a JPEG to our cacheDir/captures/, we
             hand it a content:// URI scoped to this provider, then
             the FileProvider grants the camera read/write access
             without exposing the rest of the app's storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- M2-T5: quick-settings tile. The user adds Baton from the
             system shade; tapping fires the QUICK_CAPTURE deep link
             into MainActivity. label uses @string/tile_label so it
             shows in the tile picker. -->
        <service
            android:name=".features.capture.BatonTileService"
            android:label="@string/tile_label"
            android:icon="@mipmap/ic_launcher"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- M2-T5: home-screen / lock-screen widget. Same deep link
             as the tile. -->
        <receiver
            android:name=".features.capture.BatonCaptureWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- M2-T4: voice capture foreground service. The user
             taps the mic icon in the NoteBar; the service starts
             recording, transcribes via WhisperBridge, and emits
             the transcript back to the activity via a ResultReceiver
             (an Intent extra) so the capture sheet can pre-fill.
             foregroundServiceType=microphone is required on API 34+. -->
        <service
            android:name=".features.capture.VoiceCaptureService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
