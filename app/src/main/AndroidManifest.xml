<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- M1-T6: Calendar integration via CalendarContract.ACTION_INSERT.
         The system Calendar app handles the per-account picker; on
         API 33+ the WRITE_CALENDAR permission is NOT needed because
         the user picks the calendar in the system UI. The
         `maxSdkVersion=32` keeps the manifest clean for newer API
         levels and avoids the runtime permission dance. -->
    <uses-permission
        android:name="android.permission.WRITE_CALENDAR"
        android:maxSdkVersion="32" />

    <application
        android:name=".BatonApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Baton">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Baton">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M1-T7: text-share target. The user picks Baton from
             another app's share sheet; we forward the shared text
             to MainActivity which opens the capture sheet pre-filled.
             M2 will add an image/* MIME type alongside the OCR
             pipeline. -->
        <activity-alias
            android:name=".features.capture.ShareReceiverActivity"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/share_to_baton">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
